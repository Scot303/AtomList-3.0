# __API_ORIGIN__ is replaced at build time with the origin from VITE_API_BASE_URL, so every
# deployment permits exactly the backend it was built against. Do not resolve it by hand.
#
# style-src keeps 'unsafe-inline' because framer-motion appends a populated <style> element to head,
# which a static file cannot nonce. Dropping it breaks animations silently, in production only.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' __API_ORIGIN__

#
# immutable is deliberately absent: it would suppress revalidation even on an explicit reload, which is exactly the recovery path a user reaches for first.
/assets/*
  Cache-Control: public, max-age=31536000
