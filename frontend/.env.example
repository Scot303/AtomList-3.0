# Origin of the backend API - host only, no trailing slash, no /api suffix.
# Inlined into the bundle at build time, so it must be set wherever the build runs.
#
#   local backend        http://localhost:8080
#   Railway dev backend  https://api-dev.atomlist.pl
#   production           https://api.atomlist.pl
#
# Whatever origin the frontend is served from must also be listed in the backend's
# CORS_ALLOWED_ORIGIN_PATTERNS, or the browser blocks every call before it is sent.

VITE_API_BASE_URL=http://localhost:8080
